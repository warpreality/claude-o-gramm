# Папка с проектами (можно вместо этого передать --repos)
REPOS_DIR=

# --- Telegram (оставь пустым, если не нужен) ---
# Токен бота от @BotFather (в настройках бота включи Threaded Mode)
BOT_TOKEN=
# Кому можно пользоваться ботом: Telegram user id через запятую
ALLOWED_USER_IDS=

# --- Mattermost (оставь пустым, если не нужен) ---
# Адрес сервера и токен бот-аккаунта
# MM_URL=https://mattermost.example.com
# MM_TOKEN=
# Кому можно пользоваться ботом: логины через запятую
# MM_ALLOWED_USERS=ivan.petrov,anna.smirnova
# Адрес, по которому сервер Mattermost достучится до бота (для кнопок)
# MM_CALLBACK_URL=http://10.0.0.5:8765/mm/action
# Где бот слушает нажатия кнопок (по умолчанию 0.0.0.0:8765)
# MM_CALLBACK_LISTEN=0.0.0.0:8765

# --- необязательно ---
# Путь к claude, если его нет в PATH
# CLAUDE_BIN=/home/ubuntu/.local/bin/claude
# Режим разрешений: auto (по умолчанию) | acceptEdits | manual
# CLAUDE_PERMISSION_MODE=auto
# Дополнительные аргументы для claude, например модель
# CLAUDE_EXTRA_ARGS=--model opus
# Часовой пояс для времени сброса лимитов и т.п.
# TZ=Europe/Minsk
# Через сколько часов без активности закрывать сессию Claude (0 — не закрывать).
# Контекст не теряется: следующее сообщение поднимет сессию через --resume.
# TGC_IDLE_HOURS=6
# Где хранить состояние (по умолчанию ~/.tg-claude)
# TGC_STATE_DIR=
